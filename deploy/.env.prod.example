# Production settings for docker-compose.prod.yml. Copy to .env.prod (gitignored) and fill in.
# Generate each secret with:  openssl rand -hex 32
# Use hex (letters and digits only) for passwords: they go inside MongoDB connection URIs.

SERVER_NAME=skillup.example.ac.in         # Public host name (DNS A record → this server)
CERTS_DIR=./deploy/certs                  # Host folder with fullchain.pem and privkey.pem
TLS_CERT=/etc/nginx/certs/fullchain.pem   # Paths as seen inside the web container
TLS_KEY=/etc/nginx/certs/privkey.pem

JWT_ACCESS_SECRET=                        # 32+ random bytes; different from the refresh secret
JWT_REFRESH_SECRET=

MONGO_ROOT_USER=root                      # Created on the first start only
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=skillup                    # readWrite on acet_skillup (used by api and worker)
MONGO_APP_PASSWORD=
MONGO_BACKUP_USER=backup                  # backup + restore roles (used by the backup service)
MONGO_BACKUP_PASSWORD=

API_WORKERS=0                             # 0 = one API process per CPU core
LOG_LEVEL=info

LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_CHAT_MODEL=qwen2.5:7b-instruct
LLM_EMBED_MODEL=nomic-embed-text

STT_PROVIDER=none                         # openai-compatible to enable voice answers (local Whisper)
# STT_BASE_URL=http://whisper:8000

BACKUP_DIR=./backups                      # Host folder; copy it off the server regularly
BACKUP_TIME=02:30                         # Daily, server time zone (TZ)
BACKUP_RETENTION_DAYS=30
TZ=Asia/Kolkata
