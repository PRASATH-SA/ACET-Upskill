# ACET SkillUp worker (Agenda jobs). Copy to .env.
NODE_ENV=development
LOG_LEVEL=info
MONGO_URI=mongodb://127.0.0.1:27017/acet_skillup?replicaSet=rs0  # Same database as the API
MASTERY_OVERDUE_DAYS=3                   # Must match the API
MASTERY_CONFIDENT_SCORE=80
MASTERY_MIN_REVISIONS_PASSED=1
LLM_PROVIDER=ollama                      # The worker runs AI jobs (A1–A3)
LLM_BASE_URL=http://localhost:11434
LLM_CHAT_MODEL=qwen2.5:7b-instruct
LLM_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_MS=120000                    # Per-call timeout
LLM_MAX_CONCURRENCY=2                    # Parallel LLM calls from this worker
RAG_TOP_K=6                              # Must match the API (A2)
RAG_MIN_SCORE=0.35
RAG_MIN_CHUNKS=1
RAG_MIN_WORDS=150
UPLOAD_DIR=../api/uploads                # Must point at the API's upload folder (voice answers, purge)
AUDIO_RETENTION_DAYS=30                  # Must match the API: daily purge of old voice recordings
EXPLAIN_SPOT_CHECK_RATE=0.1              # Must match the API

# Speech-to-text for explain-it-back voice answers. LOCAL Whisper server only (A.7.9);
# any OpenAI-compatible /v1/audio/transcriptions server works (whisper.cpp, speaches, LocalAI).
STT_PROVIDER=none                        # none (voice off; text answers still work) | openai-compatible (mock: tests only)
STT_BASE_URL=http://localhost:8080             # Whisper server URL
STT_MODEL=whisper-small                  # Model name the speech server expects
STT_LANGUAGE=en                          # Transcription language hint
STT_TIMEOUT_MS=60000                     # Per-recording timeout
