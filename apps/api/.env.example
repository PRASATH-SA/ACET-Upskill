# ACET SkillUp API. Copy to .env (never commit .env).
NODE_ENV=development                     # development | test | production
LOG_LEVEL=info                           # trace | debug | info | warn | error | fatal
APP_VERSION=0.1.0                        # Shown by GET /api/v1/health
API_PORT=4000                            # Port the API listens on
WEB_ORIGIN=http://localhost:5173         # Allowed CORS origin (the web app)
# Local without Docker: run "npm run db:dev -w @acet/api" and use the replica-set URI below.
MONGO_URI=mongodb://127.0.0.1:27017/acet_skillup?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1   # 16+ chars; signs 15-minute access tokens
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2  # 16+ chars; must differ from the access secret
JWT_ACCESS_TTL=15m                       # Access token lifetime
JWT_REFRESH_TTL=7d                       # Refresh token lifetime (httpOnly cookie)
COOKIE_SECURE=true                       # Keep true; browsers allow secure cookies on http://localhost
BCRYPT_ROUNDS=12                         # Password hashing cost
LOGIN_RATE_LIMIT_PER_MIN=5               # Login attempts per minute per IP + email
API_RATE_LIMIT_PER_MIN=300               # All requests per minute per IP
UPLOAD_DIR=./uploads                     # Where uploaded files are stored (local disk storage)
UPLOAD_MAX_MB=25                         # Maximum upload size in MB

# Mastery and report thresholds (B4, B5)
MASTERY_CONFIDENT_SCORE=80               # Latest quiz % needed for "confident"
MASTERY_MIN_REVISIONS_PASSED=1           # Revisions passed needed for "confident"
MASTERY_OVERDUE_DAYS=3                   # Days overdue before "needsRevision"
CO_ATTAINMENT_THRESHOLD=60               # % score a student needs to attain a CO
MENTOR_INACTIVE_DAYS=7                   # Days without activity that flag a student
MENTOR_RISK_NEEDS_REVISION=3             # needsRevision topics that flag a student

# Local LLM (A.7) — used from Phase A1 onwards
LLM_PROVIDER=ollama                      # ollama | openai-compatible (mock: tests only, refused in production)
LLM_BASE_URL=http://localhost:11434      # Ollama default; LM Studio is http://localhost:1234
LLM_CHAT_MODEL=qwen2.5:7b-instruct       # Chat/generation model
LLM_EMBED_MODEL=nomic-embed-text         # Embedding model
LLM_TIMEOUT_MS=120000                    # Per-call timeout
LLM_MAX_CONCURRENCY=2                    # Parallel LLM calls
# LLM_API_KEY=                           # Optional bearer token for OpenAI-compatible servers
AI_JOB_RUNNER=agenda                     # agenda (worker runs AI jobs) | inline (this process; tests/e2e)
# PROMPTS_DIR=../../prompts              # Prompt templates; defaults to <repo>/prompts

# Retrieval (A2)
RAG_TOP_K=6                              # Chunks returned per retrieval
RAG_MIN_SCORE=0.35                       # Minimum cosine similarity
RAG_MIN_CHUNKS=1                         # Coverage check: chunks needed per topic
RAG_MIN_WORDS=150                        # Coverage check: words of notes needed per topic

# Tutor (A4)
TUTOR_RATE_LIMIT_PER_HOUR=20             # Questions per student per hour
TUTOR_MAX_QUESTION_CHARS=500             # Longest question accepted
TUTOR_MIN_RELEVANCE=0.35                 # Off-topic if similarity is below this AND no words are shared; tune per embed model
TUTOR_MIN_PASSAGE_SCORE=0.3              # Passages at or above this similarity ground an answer
