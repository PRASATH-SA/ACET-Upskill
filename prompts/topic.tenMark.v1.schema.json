{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topic.tenMark.v1",
  "type": "object",
  "required": ["definition", "need", "points", "example", "advantages", "conclusion"],
  "additionalProperties": false,
  "properties": {
    "definition": { "type": "string", "minLength": 10, "maxLength": 600 },
    "need": { "type": "string", "minLength": 10, "maxLength": 800 },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["heading", "text"],
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string", "minLength": 2, "maxLength": 100 },
          "text": { "type": "string", "minLength": 10, "maxLength": 800 }
        }
      }
    },
    "example": { "type": "string", "minLength": 10, "maxLength": 1500 },
    "advantages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "conclusion": { "type": "string", "minLength": 10, "maxLength": 600 }
  }
}
