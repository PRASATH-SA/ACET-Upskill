{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "explain.score.v1",
  "type": "object",
  "required": ["perCriterion", "feedback"],
  "additionalProperties": false,
  "properties": {
    "perCriterion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["criterionId", "score", "evidence", "missing"],
        "additionalProperties": false,
        "properties": {
          "criterionId": { "type": "string", "minLength": 1, "maxLength": 40 },
          "score": { "type": "integer", "minimum": 0, "maximum": 10 },
          "evidence": { "type": "string", "maxLength": 400 },
          "missing": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "feedback": { "type": "string", "minLength": 10, "maxLength": 600 }
  }
}
