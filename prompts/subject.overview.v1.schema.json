{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "subject.overview.v1",
  "type": "object",
  "required": ["tagline", "why", "prerequisites", "outcomes", "applications", "units"],
  "additionalProperties": false,
  "properties": {
    "tagline": { "type": "string", "minLength": 5, "maxLength": 160 },
    "why": { "type": "string", "minLength": 20, "maxLength": 800 },
    "prerequisites": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["title", "why"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "why": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 5, "maxLength": 200 }
    },
    "applications": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "units": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["number", "summary", "youWillBeAbleTo", "leadsTo"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 20 },
          "summary": { "type": "string", "maxLength": 300 },
          "youWillBeAbleTo": { "type": "string", "maxLength": 240 },
          "leadsTo": { "type": "string", "maxLength": 240 }
        }
      }
    }
  }
}
