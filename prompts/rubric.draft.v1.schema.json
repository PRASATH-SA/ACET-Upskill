{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rubric.draft.v1",
  "type": "object",
  "required": ["prompt", "criteria", "passScore"],
  "additionalProperties": false,
  "properties": {
    "prompt": { "type": "string", "minLength": 10, "maxLength": 300 },
    "criteria": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "points", "keyIdeas"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 3, "maxLength": 300 },
          "points": { "type": "integer", "minimum": 1, "maximum": 3 },
          "keyIdeas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    },
    "passScore": { "type": "integer", "minimum": 1, "maximum": 12 }
  }
}
