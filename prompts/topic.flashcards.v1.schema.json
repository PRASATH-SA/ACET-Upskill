{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topic.flashcards.v1",
  "type": "object",
  "required": ["cards"],
  "additionalProperties": false,
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["front", "back"],
        "additionalProperties": false,
        "properties": {
          "front": { "type": "string", "minLength": 5, "maxLength": 300 },
          "back": { "type": "string", "minLength": 2, "maxLength": 600 }
        }
      }
    }
  }
}
