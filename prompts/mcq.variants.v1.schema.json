{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcq.variants.v1",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "stem",
          "options",
          "correctIndex",
          "explanation",
          "optionExplanations",
          "difficulty"
        ],
        "additionalProperties": false,
        "properties": {
          "stem": { "type": "string", "minLength": 5, "maxLength": 600 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
          "explanation": { "type": "string", "minLength": 5, "maxLength": 800 },
          "optionExplanations": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 500 }
          },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] }
        }
      }
    }
  }
}
