# Root .env is read by docker compose only. Each app also has its own .env.example
# (apps/api/.env.example, apps/worker/.env.example) for running without Docker.

# Required: long random strings, different from each other.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_ORIGIN=http://localhost:5173         # Where the web app runs (CORS origin)
LOG_LEVEL=info                           # trace | debug | info | warn | error

# Local LLM (A.7)
LLM_PROVIDER=ollama                      # ollama | openai-compatible (mock: tests only, refused in production)
LLM_BASE_URL=http://ollama:11434         # Inside compose; use http://localhost:11434 outside Docker
LLM_CHAT_MODEL=qwen2.5:7b-instruct       # Fallback: llama3.1:8b
LLM_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_MS=120000
LLM_MAX_CONCURRENCY=2
